{
  "version": "1.0",
  "model": {
    "provider": "deepseek",
    "name": "deepseek-flash",
    "baseURL": "https://api.deepseek.com",
    "apiKey": "${DEEPSEEK_API_KEY}",
    "contextWindow": 1000000,
    "disableReasoning": true,
    "budgetLimit": 1000000
  },
  "plugins": [
    {
      "name": "supabase",
      "enabled": false,
      "config": {
        "supabaseUrl": "${SUPABASE_URL}",
        "supabaseKey": "${SUPABASE_KEY}"
      }
    }
  ],
  "channels": {
    "feishu": {
      "enabled": false,
      "appId": "${FEISHU_APP_ID}",
      "appSecret": "${FEISHU_APP_SECRET}"
    }
  },
  "agents": {
    "maxSpawnDepth": 1,
    "maxConcurrency": 3,
    "defaultTimeout": 60000
  },
  "security": {
    "defaultRole": "owner",
    "auditLog": true,
    "bashTimestamp": true
  },
  "memory": {
    "dataDir": "."
  },
  "rag": {
    "enabled": true,
    "dbPath": "knowledge.db",
    "apiKey": ""
  },
  "cron": {
    "enabled": true,
    "dataDir": "."
  },
  "session": {
    "id": "default1"
  },
  "usage": {
    "trackingFile": ".usage/today.jsonl"
  }
}
